<?xml version="1.0" encoding="utf-8"?>
<!-- Tarjeta individual para el pase de diapositivas del widget 2x2.
     Portada a pantalla completa con índice, badge de tipo, título,
     progreso, franja de acento y botón de acción.
     Los fill-in intents y el tema los pone LibraryWidgetService. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_card_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_signal_background">

    <!-- Portada a pantalla completa. -->
    <ImageView
        android:id="@+id/widget_card_poster"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:background="@drawable/widget_signal_poster_placeholder"
        android:contentDescription="@string/widget_library_title" />

    <!-- Degradado inferior para legibilidad del título. -->
    <ImageView
        android:id="@+id/widget_card_scrim"
        android:layout_width="match_parent"
        android:layout_height="112dp"
        android:layout_gravity="bottom"
        android:scaleType="fitXY"
        android:src="@drawable/widget_small_scrim"
        android:contentDescription="@null" />

    <!-- Índice y badge de tipo (esquina superior izquierda). -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="10dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/widget_signal_badge"
            android:paddingStart="7dp"
            android:paddingEnd="9dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp">

            <FrameLayout
                android:layout_width="3dp"
                android:layout_height="11dp"
                android:background="@color/widget_signal_red" />

            <TextView
                android:id="@+id/widget_card_index"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="sans-serif-condensed"
                android:letterSpacing="0.14"
                android:textColor="@color/widget_signal_text"
                android:textSize="11sp"
                android:textStyle="bold"
                android:text="01" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_card_kind"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/widget_signal_badge"
            android:paddingStart="9dp"
            android:paddingEnd="9dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:fontFamily="sans-serif-condensed"
            android:letterSpacing="0.12"
            android:textColor="@color/widget_signal_red"
            android:textSize="10sp"
            android:textStyle="bold"
            android:text="—" />
    </LinearLayout>

    <!-- Título y progreso (esquina inferior izquierda). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="68dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/widget_card_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/widget_signal_text"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end"
            android:text="—" />

        <TextView
            android:id="@+id/widget_card_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAllCaps="true"
            android:fontFamily="sans-serif-condensed"
            android:letterSpacing="0.08"
            android:textColor="@color/widget_signal_text_dim"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="—" />
    </LinearLayout>

    <!-- Franja inferior con el color del tipo (la tiñe el servicio). -->
    <ImageView
        android:id="@+id/widget_card_accent"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="24dp"
        android:src="@drawable/widget_signal_bar"
        android:scaleType="fitXY"
        android:contentDescription="@null" />

    <!-- Botón +1 / completar (esquina inferior derecha, 48dp). -->
    <ImageView
        android:id="@+id/widget_card_plus"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="13dp"
        android:background="@drawable/widget_signal_button"
        android:src="@drawable/widget_ic_plus"
        android:scaleType="center"
        android:contentDescription="@string/widget_library_increment" />

    <!-- Esquinas redondeadas sobre la portada (las recolorea el servicio). -->
    <ImageView
        android:id="@+id/widget_card_round_top_start"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_gravity="top|start"
        android:src="@drawable/widget_signal_round_top_start"
        android:contentDescription="@null" />

    <ImageView
        android:id="@+id/widget_card_round_top_end"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_gravity="top|end"
        android:src="@drawable/widget_signal_round_top_end"
        android:contentDescription="@null" />

    <ImageView
        android:id="@+id/widget_card_round_bottom_start"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_gravity="bottom|start"
        android:src="@drawable/widget_signal_round_bottom_start"
        android:contentDescription="@null" />

    <ImageView
        android:id="@+id/widget_card_round_bottom_end"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_gravity="bottom|end"
        android:src="@drawable/widget_signal_round_bottom_end"
        android:contentDescription="@null" />

</FrameLayout>
