<?xml version="1.0" encoding="utf-8"?>
<!-- Rounds a square corner by painting the outside of a 12dp arc in the widget
     background colour (recoloured at runtime). Used over posters and actions. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="12dp"
    android:height="12dp"
    android:viewportWidth="12"
    android:viewportHeight="12">
    <path
        android:fillColor="@color/widget_signal_ink"
        android:pathData="M0,0 L12,0 A12,12 0 0,0 0,12 Z" />
</vector>
