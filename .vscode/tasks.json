{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "cronicle:dev-api-proxy",
      "type": "shell",
      "command": "node",
      "args": ["scripts/dev_api_proxy.mjs"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "cronicle",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "dev_api_proxy escuchando"
        }
      },
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated"
      }
    }
  ]
}
